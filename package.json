{
  "name": "seasonal-qr",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:scan": "playwright test",
    "reveal:strip": "node tools/reveal-strip.mjs",
    "tree:build": "/Applications/Blender.app/Contents/MacOS/Blender -b -P tools/tree-build/sakura.py && /Applications/Blender.app/Contents/MacOS/Blender -b -P tools/tree-build/autumn.py",
    "tree:open": "tools/tree-build/open.sh"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.0",
    "mediabunny": "^1.65.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@zxing/library": "^0.23.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
